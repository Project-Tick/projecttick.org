---
interface Props {
	type?: "info" | "success" | "warn" | "danger";
	class?: string;
}

const { type = "info", class: className = "" } = Astro.props;

const variants = {
	info: "border-meshmc-info bg-meshmc-info/10",
	success: "border-meshmc-success bg-meshmc-success/10",
	warn: "border-meshmc-warn bg-meshmc-warn/10",
	danger: "border-meshmc-danger bg-meshmc-danger/10",
} as const;
---

<div
	class={`rounded-md border border-l-5 px-6 my-6 ${variants[type]} ${className}`}
>
	<slot />
</div>
